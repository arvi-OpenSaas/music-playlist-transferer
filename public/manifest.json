{
  "manifest_version": 3,
  "name": "HarmonySync",
  "description": "Universal Music Playlist Migration Platform",
  "version": "1.0.0",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "identity" 
  ],
  "host_permissions": [
    "*://*.apple.com/*",
    "*://*.youtube.com/*",
    "*://*.spotify.com/*" 
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "HarmonySync",
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  }
}
